@page
@model BeatSync.Web.Pages.Beats.UploadModel
@{
    ViewData["Title"] = "Upload Beat";
}

<h2 class="mb-3">Upload Beat</h2>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Genre" class="form-label"></label>
            <input asp-for="Input.Genre" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Bpm" class="form-label"></label>
            <input asp-for="Input.Bpm" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Key" class="form-label"></label>
            <input asp-for="Input.Key" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.Mood" class="form-label"></label>
            <input asp-for="Input.Mood" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.Instruments" class="form-label"></label>
            <input asp-for="Input.Instruments" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Audio File (MP3/WAV)</label>
        <input asp-for="AudioFile" type="file" class="form-control" />
        <span class="form-text">Max size depends on server limits.</span>
    </div>
    <div class="mb-3">
        <label class="form-label">Cover Image (optional)</label>
        <input asp-for="CoverImage" type="file" class="form-control" />
    </div>
    <button type="submit" class="btn cta">Upload</button>
</form>
